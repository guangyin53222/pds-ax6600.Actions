#!/bin/sh
# ============================================================
# LibWrt AX6600 自动挂载 + Samba 自动共享（刷完生效）
# 适用于 USB 硬盘 / U 盘
# ============================================================

# 等待系统完全启动
sleep 10

# ========== 自动挂载 ==========
# 启用 blockd 自动挂载
uci set fstab.@global[0].anon_mount=1
uci set fstab.@global[0].auto_mount=1
uci set fstab.@global[0].auto_swap=0
uci commit fstab

# 确保 blockd 开机启动
/etc/init.d/blockd enable
/etc/init.d/blockd start

# ========== Samba4 自动共享 ==========
# 启用 Samba4
/etc/init.d/samba4 enable
/etc/init.d/samba4 start

# 创建匿名共享（USB 设备统一挂载在 /mnt）
SHARE_NAME="USB-Share"
SHARE_PATH="/mnt"

# 删除旧的同名共享（防止重复）
uci -q delete samba4.@sambashare[0]

# 添加新共享
uci add samba4 sambashare
uci set samba4.@sambashare[-1].name="$SHARE_NAME"
uci set samba4.@sambashare[-1].path="$SHARE_PATH"
uci set samba4.@sambashare[-1].users="root"
uci set samba4.@sambashare[-1].guest_ok="yes"
uci set samba4.@sambashare[-1].read_only="no"
uci set samba4.@sambashare[-1].create_mask="0777"
uci set samba4.@sambashare[-1].dir_mask="0777"
uci set samba4.@sambashare[-1].enabled="yes"

uci commit samba4
/etc/init.d/samba4 restart

exit 0